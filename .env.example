# The dev-only Vite gateway reads these variables on the Node side.
# Do not prefix them with VITE_, otherwise they are exposed to the browser.
CODEX2API_API_KEY=
AI_IMAGE_API_KEY=
AI_BASE_URL=https://www.codex2api.com
AI_VISION_MODEL=gpt-6.1-sol
AI_IMAGE_MODEL=gpt-image-2.6
# Set only vision models verified with the same key; comma-separated, at most two fallbacks.
AI_VISION_FALLBACK_MODELS=
AI_ANALYSIS_TOTAL_TIMEOUT_MS=300000
AI_ANALYSIS_TIMEOUT_MS=120000
AI_REVIEW_TIMEOUT_MS=90000
AI_IMAGE_TIMEOUT_MS=180000
VITE_BUSINESS_API_URL=http://localhost:8091
# Shared secret between the Vite gateway and Spring Boot /internal/wallet (>=32 chars).
# The backend does not read .env; pass the same value as a process environment variable when running it.
CREDIT_GATEWAY_SECRET=
