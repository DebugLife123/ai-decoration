# The dev-only Vite gateway reads these variables on the Node side.
# Do not prefix them with VITE_, otherwise they are exposed to the browser.
CODEX2API_API_KEY=
AI_BASE_URL=https://codex2api.com
AI_VISION_MODEL=grok-4.7
AI_IMAGE_MODEL=grok-imagine-image-quality
AI_ANALYSIS_TIMEOUT_MS=90000
AI_REVIEW_TIMEOUT_MS=90000
AI_IMAGE_TIMEOUT_MS=180000

# Local Spring Boot API used by personal/business login and authenticated data.
# 构建期注入：docker compose build 时传给前端镜像，并被编译进 JS bundle。
# 留空 = 前端走同源相对路径，需要前置反向代理把 /api 转到 backend。
# 本地 `npm run dev` 不需要设置这一项，dev 模式自动回落到 http://localhost:8080。
# 注意：填 http://localhost:8080 后构建的镜像一旦部署到服务器，浏览器会去请求
# 访问者自己机器上的 8080（页面能开、登录一直转圈）。生产填真实对外地址。
VITE_BUSINESS_API_URL=
# Optional development-only static token for testing without signing in.
VITE_BUSINESS_API_TOKEN=

# ── docker compose 四服务 ─────────────────────────────────────────────
# 数据库口令。不设置时 compose 回落到 decoration/decoration，仅适合本机。
DATABASE_USERNAME=decoration
DATABASE_PASSWORD=decoration

# 生产必填：JWT 签名密钥，至少 32 字节。compose 会校验它非空。
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# 生产必填：浏览器可访问后端时允许的额外来源，逗号分隔。
# 同源部署（前端与后端同一域名/端口反代）可留空。
CORS_ALLOWED_ORIGINS=

# prod = 收紧 actuator 端点、关闭 bootstrap、强制 JWT_SECRET 注入
SPRING_PROFILES_ACTIVE=prod
