{
    "compilerOptions": {
        "target": "ES2018",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "rootDir": "src",
        "types": ["vite/client"]
    },
    "include": ["src"]
}
